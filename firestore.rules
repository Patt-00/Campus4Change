rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Version 1 keeps each student's private account state under their UID.
    match /users/{userId}/private/state {
      function ownsDocument() {
        return ownsUserData(userId);
      }

      allow read, delete: if ownsDocument();
      allow create, update: if ownsDocument()
        && request.resource.data.keys().hasAll(['state', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state is map
        && request.resource.data.state.version == 1
        && request.resource.data.state.profile is map
        && request.resource.data.state.profile.id == userId
        && request.resource.data.updatedAt is timestamp;
    }

    // Study group metadata is visible to signed-in students. Membership IDs
    // are private to their owners; a public count lives on the group document.
    match /studyGroups/{groupId} {
      function memberPath(userId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/members/$(userId);
      }

      function writeLimitPath(userId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/writeLimits/$(userId);
      }

      function postPath(postId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/posts/$(postId);
      }

      function replyPath(postId, replyId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/posts/$(postId)/replies/$(replyId);
      }

      function hasPostWritePermit(postId) {
        let permit = getAfter(writeLimitPath(request.auth.uid)).data;
        return permit.uid == request.auth.uid
          && permit.lastWriteAt == request.time
          && permit.kind == 'post'
          && permit.writeId == postId
          && permit.postId == null;
      }

      function hasReplyWritePermit(postId, replyId) {
        let permit = getAfter(writeLimitPath(request.auth.uid)).data;
        return permit.uid == request.auth.uid
          && permit.lastWriteAt == request.time
          && permit.kind == 'reply'
          && permit.writeId == replyId
          && permit.postId == postId;
      }

      function groupPath() {
        return /databases/$(database)/documents/studyGroups/$(groupId);
      }

      function isMember() {
        return signedIn() && exists(memberPath(request.auth.uid));
      }

      function touchesOnlyActivity() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }

      function changesMemberCount() {
        let currentMember = exists(memberPath(request.auth.uid));
        let memberAfter = existsAfter(memberPath(request.auth.uid));
        let oldCount = resource.data.memberCount;
        let newCount = request.resource.data.memberCount;
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((newCount == oldCount + 1 && !currentMember && memberAfter)
            || (newCount == oldCount - 1 && currentMember && !memberAfter));
      }

      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'ownerUid', 'name', 'subject', 'meetup', 'meetupAt', 'room',
          'memberCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'subject', 'meetup', 'meetupAt', 'room',
          'memberCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 100
        && request.resource.data.meetup is string
        && request.resource.data.meetup.size() <= 1000
        && (request.resource.data.meetupAt == null || request.resource.data.meetupAt is string)
        && request.resource.data.room is string
        && request.resource.data.room.size() <= 100
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(memberPath(request.auth.uid));
      allow update: if (isMember() && touchesOnlyActivity())
        || changesMemberCount();
      allow delete: if false;

      match /members/{userId} {
        function parentGroup() {
          return /databases/$(database)/documents/studyGroups/$(groupId);
        }

        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['uid', 'role', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['uid', 'role', 'joinedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.joinedAt == request.time
          && ((request.resource.data.role == 'owner'
              && getAfter(parentGroup()).data.ownerUid == userId
              && getAfter(parentGroup()).data.memberCount == 1)
            || (request.resource.data.role == 'member'
              && exists(parentGroup())
              && getAfter(parentGroup()).data.memberCount
                == get(parentGroup()).data.memberCount + 1));
        allow update: if false;
        allow delete: if signedIn()
          && request.auth.uid == userId
          && resource.data.role == 'member'
          && getAfter(parentGroup()).data.memberCount
            == get(parentGroup()).data.memberCount - 1
          && getAfter(parentGroup()).data.updatedAt == request.time;
      }

      // One group contribution per member every five seconds. The private
      // limiter is updated atomically with exactly one matching post or reply.
      match /writeLimits/{userId} {
        function matchingWrite() {
          let data = request.resource.data;
          return data.keys().hasAll([
              'uid', 'lastWriteAt', 'kind', 'writeId', 'postId'
            ])
            && data.keys().hasOnly([
              'uid', 'lastWriteAt', 'kind', 'writeId', 'postId'
            ])
            && data.uid == userId
            && data.lastWriteAt == request.time
            && data.writeId is string
            && data.writeId.size() > 0
            && data.writeId.size() <= 128
            && ((data.kind == 'post'
                && data.postId == null
                && existsAfter(postPath(data.writeId))
                && getAfter(postPath(data.writeId)).data.authorUid == userId
                && getAfter(postPath(data.writeId)).data.createdAt == request.time)
              || (data.kind == 'reply'
                && data.postId is string
                && data.postId.size() > 0
                && data.postId.size() <= 128
                && existsAfter(replyPath(data.postId, data.writeId))
                && getAfter(replyPath(data.postId, data.writeId)).data.authorUid == userId
                && getAfter(replyPath(data.postId, data.writeId)).data.createdAt == request.time));
        }

        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create: if signedIn()
          && request.auth.uid == userId
          && matchingWrite();
        allow update: if signedIn()
          && request.auth.uid == userId
          && matchingWrite()
          && resource.data.lastWriteAt is timestamp
          && request.time >= resource.data.lastWriteAt + duration.value(5, 's');
        allow delete: if false;
      }

      match /posts/{postId} {
        function parentGroup() {
          return /databases/$(database)/documents/studyGroups/$(groupId);
        }

        function memberPath() {
          return /databases/$(database)/documents/studyGroups/$(groupId)/members/$(request.auth.uid);
        }

        allow get: if isMember();
        allow list: if isMember()
          && request.query.limit is int
          && request.query.limit <= 20;
        allow create: if signedIn()
          && exists(memberPath())
          && request.resource.data.keys().hasAll(['authorUid', 'author', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorUid', 'author', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 3000
          && request.resource.data.createdAt == request.time
          && hasPostWritePermit(postId);
        allow update, delete: if false;

        match /replies/{replyId} {
          function memberPath() {
            return /databases/$(database)/documents/studyGroups/$(groupId)/members/$(request.auth.uid);
          }

          allow get: if signedIn() && exists(memberPath());
          allow list: if signedIn()
            && exists(memberPath())
            && request.query.limit is int
            && request.query.limit <= 20;
          allow create: if signedIn()
            && exists(memberPath())
            && exists(/databases/$(database)/documents/studyGroups/$(groupId)/posts/$(postId))
            && request.resource.data.keys().hasAll(['authorUid', 'author', 'text', 'createdAt'])
            && request.resource.data.keys().hasOnly(['authorUid', 'author', 'text', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.author is string
            && request.resource.data.author.size() <= 100
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.createdAt == request.time
            && hasReplyWritePermit(postId, replyId);
          allow update, delete: if false;
        }
      }
    }

    // Every collection not listed above is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
