rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/studyGroupMemberships/{groupId} {
      function groupPath() {
        return /databases/$(database)/documents/studyGroups/$(groupId);
      }

      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'groupId', 'role', 'joinedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'groupId', 'role', 'joinedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.groupId == groupId
        && request.resource.data.role in ['owner', 'member']
        && request.resource.data.joinedAt == request.time
        && existsAfter(groupPath())
        && ((request.resource.data.role == 'owner'
            && getAfter(groupPath()).data.ownerUid == userId
            && getAfter(groupPath()).data.memberCount == 1)
          || (request.resource.data.role == 'member'
            && get(groupPath()).data.ownerUid != userId
            && getAfter(groupPath()).data.memberCount
              == get(groupPath()).data.memberCount + 1));
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == userId
        && resource.data.uid == userId
        && resource.data.groupId == groupId
        && resource.data.role == 'member'
        && exists(groupPath())
        && getAfter(groupPath()).data.memberCount
          == get(groupPath()).data.memberCount - 1
        && getAfter(groupPath()).data.updatedAt == request.time;
    }

    // Version 1 keeps each student's private account state under their UID.
    match /users/{userId}/private/state {
      function ownsDocument() {
        return ownsUserData(userId);
      }

      allow read, delete: if ownsDocument();
      allow create, update: if ownsDocument()
        && request.resource.data.keys().hasAll(['state', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state is map
        && request.resource.data.state.version == 1
        && request.resource.data.state.profile is map
        && request.resource.data.state.profile.id == userId
        && request.resource.data.updatedAt is timestamp;
    }

    // Study group metadata is visible to signed-in students. Membership IDs
    // are private to their owners; a public count lives on the group document.
    match /studyGroups/{groupId} {
      function userMembershipPath(userId) {
        return /databases/$(database)/documents/users/$(userId)/studyGroupMemberships/$(groupId);
      }

      function writeLimitPath(userId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/writeLimits/$(userId);
      }

      function postPath(postId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/posts/$(postId);
      }

      function replyPath(postId, replyId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/posts/$(postId)/replies/$(replyId);
      }

      function chatMessagePath(messageId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/chatMessages/$(messageId);
      }

      function reportPath(reportId) {
        return /databases/$(database)/documents/studyGroups/$(groupId)/moderationReports/$(reportId);
      }

      function groupPath() {
        return /databases/$(database)/documents/studyGroups/$(groupId);
      }

      function hasPostWritePermit(postId) {
        let permit = getAfter(writeLimitPath(request.auth.uid)).data;
        return permit.uid == request.auth.uid
          && permit.lastWriteAt == request.time
          && permit.kind == 'post'
          && permit.writeId == postId
          && permit.postId == null;
      }

      function hasReplyWritePermit(postId, replyId) {
        let permit = getAfter(writeLimitPath(request.auth.uid)).data;
        return permit.uid == request.auth.uid
          && permit.lastWriteAt == request.time
          && permit.kind == 'reply'
          && permit.writeId == replyId
          && permit.postId == postId;
      }

      function hasChatWritePermit(messageId) {
        let permit = getAfter(writeLimitPath(request.auth.uid)).data;
        return permit.uid == request.auth.uid
          && permit.lastWriteAt == request.time
          && permit.kind == 'chat'
          && permit.writeId == messageId
          && permit.postId == null;
      }

      function hasReportWritePermit(reportId) {
        let permit = getAfter(writeLimitPath(request.auth.uid)).data;
        return permit.uid == request.auth.uid
          && permit.lastWriteAt == request.time
          && permit.kind == 'report'
          && permit.writeId == reportId
          && permit.postId == getAfter(reportPath(reportId)).data.postId;
      }

      function isMember() {
        return signedIn()
          && exists(userMembershipPath(request.auth.uid))
          && get(userMembershipPath(request.auth.uid)).data.uid == request.auth.uid
          && get(userMembershipPath(request.auth.uid)).data.groupId == groupId;
      }

      function isGroupOwner() {
        return signedIn()
          && get(groupPath()).data.ownerUid == request.auth.uid;
      }

      function touchesOnlyActivity() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }

      function changesMemberCount() {
        let currentMembership = exists(userMembershipPath(request.auth.uid));
        let membershipAfter = existsAfter(userMembershipPath(request.auth.uid));
        let oldCount = resource.data.memberCount;
        let newCount = request.resource.data.memberCount;
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((newCount == oldCount + 1
              && !currentMembership
              && membershipAfter
              && getAfter(userMembershipPath(request.auth.uid)).data.role == 'member')
            || (newCount == oldCount - 1
              && currentMembership
              && !membershipAfter
              && get(userMembershipPath(request.auth.uid)).data.role == 'member'));
      }

      allow get: if signedIn();
      allow list: if signedIn()
        && request.query.limit is int
        && request.query.limit <= 20;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'ownerUid', 'name', 'subject', 'meetup', 'meetupAt', 'room',
          'memberCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'subject', 'meetup', 'meetupAt', 'room',
          'memberCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 100
        && request.resource.data.meetup is string
        && request.resource.data.meetup.size() <= 1000
        && (request.resource.data.meetupAt == null || request.resource.data.meetupAt is string)
        && request.resource.data.room is string
        && request.resource.data.room.size() <= 100
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(userMembershipPath(request.auth.uid))
        && getAfter(userMembershipPath(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(userMembershipPath(request.auth.uid)).data.groupId == groupId
        && getAfter(userMembershipPath(request.auth.uid)).data.role == 'owner';
      allow update: if (isMember() && touchesOnlyActivity())
        || changesMemberCount();
      allow delete: if false;

      // One group contribution per member every five seconds. The private
      // limiter is updated atomically with its matching post, reply, or report.
      match /writeLimits/{userId} {
        function matchingWrite() {
          let data = request.resource.data;
          return data.keys().hasAll([
              'uid', 'lastWriteAt', 'kind', 'writeId', 'postId'
            ])
            && data.keys().hasOnly([
              'uid', 'lastWriteAt', 'kind', 'writeId', 'postId'
            ])
            && data.uid == userId
            && data.lastWriteAt == request.time
            && data.writeId is string
            && data.writeId.size() > 0
            && data.writeId.size() <= 128
            && ((data.kind == 'post'
                && data.postId == null
                && existsAfter(postPath(data.writeId))
                && getAfter(postPath(data.writeId)).data.authorUid == userId
                && getAfter(postPath(data.writeId)).data.createdAt == request.time)
              || (data.kind == 'reply'
                && data.postId is string
                && data.postId.size() > 0
                && data.postId.size() <= 128
                && existsAfter(replyPath(data.postId, data.writeId))
                && getAfter(replyPath(data.postId, data.writeId)).data.authorUid == userId
                && getAfter(replyPath(data.postId, data.writeId)).data.createdAt == request.time)
              || (data.kind == 'chat'
                && data.postId == null
                && existsAfter(chatMessagePath(data.writeId))
                && getAfter(chatMessagePath(data.writeId)).data.senderUid == userId
                && getAfter(chatMessagePath(data.writeId)).data.sentAt == request.time)
              || (data.kind == 'report'
                && existsAfter(reportPath(data.writeId))
                && getAfter(reportPath(data.writeId)).data.createdAt == request.time
                && getAfter(reportPath(data.writeId)).data.postId == data.postId));
        }

        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create: if signedIn()
          && request.auth.uid == userId
          && matchingWrite();
        allow update: if signedIn()
          && request.auth.uid == userId
          && matchingWrite()
          && resource.data.lastWriteAt is timestamp
          && request.time >= resource.data.lastWriteAt + duration.value(5, 's');
        allow delete: if false;
      }

      match /posts/{postId} {
        allow get: if isMember() && resource.data.moderationStatus == 'visible';
        allow list: if isMember()
          && resource.data.moderationStatus == 'visible'
          && request.query.limit is int
          && request.query.limit <= 20;
        allow create: if signedIn()
          && isMember()
          && request.resource.data.keys().hasAll([
            'authorUid', 'author', 'text', 'createdAt', 'moderationStatus'
          ])
          && request.resource.data.keys().hasOnly([
            'authorUid', 'author', 'text', 'createdAt', 'moderationStatus'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 3000
          && request.resource.data.createdAt == request.time
          && request.resource.data.moderationStatus == 'visible'
          && hasPostWritePermit(postId);
        allow update: if isGroupOwner()
          && resource.data.moderationStatus in ['visible', 'hidden']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['moderationStatus', 'moderatedAt'])
          && request.resource.data.moderationStatus in ['visible', 'hidden']
          && request.resource.data.moderatedAt == request.time
          && ((resource.data.moderationStatus == 'visible'
              && request.resource.data.moderationStatus == 'hidden')
            || (resource.data.moderationStatus == 'hidden'
              && request.resource.data.moderationStatus == 'visible'));
        allow delete: if false;

        match /replies/{replyId} {
          function parentPostPath() {
            return /databases/$(database)/documents/studyGroups/$(groupId)/posts/$(postId);
          }

          allow get: if isGroupOwner()
            || (isMember()
              && exists(parentPostPath())
              && get(parentPostPath()).data.moderationStatus == 'visible'
              && resource.data.moderationStatus == 'visible');
          allow list: if (isGroupOwner() && request.query.limit is int
              && request.query.limit <= 100)
            || (isMember() && exists(parentPostPath())
              && get(parentPostPath()).data.moderationStatus == 'visible'
              && resource.data.moderationStatus == 'visible'
              && request.query.limit is int
              && request.query.limit <= 20);
          allow create: if signedIn()
            && isMember()
            && exists(/databases/$(database)/documents/studyGroups/$(groupId)/posts/$(postId))
            && get(parentPostPath()).data.moderationStatus == 'visible'
            && request.resource.data.keys().hasAll([
              'authorUid', 'author', 'text', 'createdAt', 'moderationStatus'
            ])
            && request.resource.data.keys().hasOnly([
              'authorUid', 'author', 'text', 'createdAt', 'moderationStatus'
            ])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.author is string
            && request.resource.data.author.size() <= 100
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.createdAt == request.time
            && request.resource.data.moderationStatus == 'visible'
            && hasReplyWritePermit(postId, replyId);
          allow update: if isGroupOwner()
            && resource.data.moderationStatus in ['visible', 'hidden']
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['moderationStatus', 'moderatedAt'])
            && request.resource.data.moderationStatus in ['visible', 'hidden']
            && request.resource.data.moderatedAt == request.time
            && ((resource.data.moderationStatus == 'visible'
                && request.resource.data.moderationStatus == 'hidden')
              || (resource.data.moderationStatus == 'hidden'
                && request.resource.data.moderationStatus == 'visible'));
          allow delete: if false;
        }
      }

      match /chatMessages/{messageId} {
        allow get: if isGroupOwner()
          || (isMember() && resource.data.moderationStatus == 'visible');
        allow list: if (isGroupOwner() || isMember())
          && resource.data.moderationStatus == 'visible'
          && request.query.limit is int
          && request.query.limit <= 50;
        allow create: if isMember()
          && request.resource.data.keys().hasAll([
            'senderUid', 'senderName', 'text', 'sentAt', 'moderationStatus'
          ])
          && request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'sentAt', 'moderationStatus'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt == request.time
          && request.resource.data.moderationStatus == 'visible'
          && hasChatWritePermit(messageId);
        allow update: if isGroupOwner()
          && resource.data.moderationStatus in ['visible', 'hidden']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['moderationStatus', 'moderatedAt'])
          && request.resource.data.moderationStatus in ['visible', 'hidden']
          && request.resource.data.moderatedAt == request.time
          && ((resource.data.moderationStatus == 'visible'
              && request.resource.data.moderationStatus == 'hidden')
            || (resource.data.moderationStatus == 'hidden'
              && request.resource.data.moderationStatus == 'visible'));
        allow delete: if false;
      }

      match /moderationReports/{reportId} {
        function reportedPostPath() {
          return /databases/$(database)/documents/studyGroups/$(groupId)/posts/$(request.resource.data.targetId);
        }

        function reportedReplyPath() {
          return /databases/$(database)/documents/studyGroups/$(groupId)/posts/$(request.resource.data.postId)/replies/$(request.resource.data.targetId);
        }

        function reportedChatMessagePath() {
          return /databases/$(database)/documents/studyGroups/$(groupId)/chatMessages/$(request.resource.data.targetId);
        }

        function reportsPost() {
          let post = get(reportedPostPath()).data;
          return request.resource.data.targetType == 'post'
            && request.resource.data.postId == null
            && exists(reportedPostPath())
            && post.moderationStatus == 'visible'
            && post.authorUid != request.auth.uid
            && post.author == request.resource.data.targetAuthor
            && post.text == request.resource.data.contentSnapshot;
        }

        function reportsReply() {
          let reply = get(reportedReplyPath()).data;
          return request.resource.data.targetType == 'reply'
            && request.resource.data.postId is string
            && request.resource.data.postId.size() > 0
            && request.resource.data.postId.size() <= 128
            && exists(reportedReplyPath())
            && get(postPath(request.resource.data.postId)).data.moderationStatus == 'visible'
            && reply.moderationStatus == 'visible'
            && reply.authorUid != request.auth.uid
            && reply.author == request.resource.data.targetAuthor
            && reply.text == request.resource.data.contentSnapshot;
        }

        function reportsChatMessage() {
          let message = get(reportedChatMessagePath()).data;
          return request.resource.data.targetType == 'chatMessage'
            && request.resource.data.postId == null
            && exists(reportedChatMessagePath())
            && message.moderationStatus == 'visible'
            && message.senderUid != request.auth.uid
            && message.senderName == request.resource.data.targetAuthor
            && message.text == request.resource.data.contentSnapshot;
        }

        allow get: if isGroupOwner();
        allow list: if isGroupOwner()
          && request.query.limit is int
          && request.query.limit <= 20;
        allow create: if isMember()
          && request.resource.data.keys().hasAll([
            'targetType', 'targetId', 'postId', 'targetAuthor',
            'contentSnapshot', 'reason', 'status', 'createdAt', 'resolvedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'targetType', 'targetId', 'postId', 'targetAuthor',
            'contentSnapshot', 'reason', 'status', 'createdAt', 'resolvedAt'
          ])
          && request.resource.data.targetId is string
          && request.resource.data.targetId.size() > 0
          && request.resource.data.targetId.size() <= 128
          && request.resource.data.targetAuthor is string
          && request.resource.data.targetAuthor.size() <= 100
          && request.resource.data.contentSnapshot is string
          && request.resource.data.contentSnapshot.size() > 0
          && request.resource.data.contentSnapshot.size() <= 3000
          && request.resource.data.reason in ['spam', 'abuse']
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time
          && request.resource.data.resolvedAt == null
          && hasReportWritePermit(reportId)
          && (reportsPost() || reportsReply() || reportsChatMessage());
        function targetIsHiddenAfter() {
          return (resource.data.targetType == 'post'
              && existsAfter(postPath(resource.data.targetId))
              && getAfter(postPath(resource.data.targetId)).data.moderationStatus == 'hidden')
            || (resource.data.targetType == 'reply'
              && existsAfter(replyPath(resource.data.postId, resource.data.targetId))
              && getAfter(replyPath(resource.data.postId, resource.data.targetId)).data.moderationStatus == 'hidden')
            || (resource.data.targetType == 'chatMessage'
              && existsAfter(chatMessagePath(resource.data.targetId))
              && getAfter(chatMessagePath(resource.data.targetId)).data.moderationStatus == 'hidden');
        }

        function targetIsVisibleAfter() {
          return (resource.data.targetType == 'post'
              && existsAfter(postPath(resource.data.targetId))
              && getAfter(postPath(resource.data.targetId)).data.moderationStatus == 'visible')
            || (resource.data.targetType == 'reply'
              && existsAfter(replyPath(resource.data.postId, resource.data.targetId))
              && getAfter(replyPath(resource.data.postId, resource.data.targetId)).data.moderationStatus == 'visible')
            || (resource.data.targetType == 'chatMessage'
              && existsAfter(chatMessagePath(resource.data.targetId))
              && getAfter(chatMessagePath(resource.data.targetId)).data.moderationStatus == 'visible');
        }

        allow update: if isGroupOwner()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt'])
          && request.resource.data.resolvedAt == request.time
          && ((resource.data.status == 'open'
              && request.resource.data.status == 'dismissed')
            || (resource.data.status == 'open'
              && request.resource.data.status == 'hidden'
              && targetIsHiddenAfter())
            || (resource.data.status == 'hidden'
              && request.resource.data.status == 'restored'
              && targetIsVisibleAfter()));
        allow delete: if false;
      }
    }

    // A tutor listing exposes only the fields students need to choose a peer
    // tutor. Contact details and Student IDs stay in the owner's private data.
    match /tutorProfiles/{tutorUid} {
      function validListing() {
        return request.resource.data.keys().hasAll([
            'uid', 'name', 'course', 'year', 'subjects', 'bio',
            'visibility', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'name', 'course', 'year', 'subjects', 'bio',
            'visibility', 'updatedAt'
          ])
          && request.resource.data.uid == tutorUid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.course is string
          && request.resource.data.course.size() <= 100
          && request.resource.data.year is string
          && request.resource.data.year.size() <= 40
          && request.resource.data.subjects is list
          && request.resource.data.subjects.size() > 0
          && request.resource.data.subjects.size() <= 10
          && request.resource.data.bio is string
          && request.resource.data.bio.size() >= 10
          && request.resource.data.bio.size() <= 1000
          && request.resource.data.visibility == 'listed'
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if signedIn() && resource.data.visibility == 'listed';
      allow list: if signedIn()
        && resource.data.visibility == 'listed'
        && request.query.limit is int
        && request.query.limit <= 20;
      allow create, update: if signedIn()
        && request.auth.uid == tutorUid
        && validListing();
      allow delete: if signedIn() && request.auth.uid == tutorUid;
    }

    // A request is visible only to the two participating students. One-hour
    // sessions reserve two half-hour buckets so overlapping start times cannot
    // both be accepted.
    match /tutorBookings/{bookingId} {
      function bookingPath() {
        return /databases/$(database)/documents/tutorBookings/$(bookingId);
      }

      function bookingChatMessagePath(messageId) {
        return /databases/$(database)/documents/tutorBookings/$(bookingId)/chatMessages/$(messageId);
      }

      function bookingChatWriteLimitPath(userId) {
        return /databases/$(database)/documents/tutorBookings/$(bookingId)/chatWriteLimits/$(userId);
      }

      function tutorProfilePath(tutorUid) {
        return /databases/$(database)/documents/tutorProfiles/$(tutorUid);
      }

      function slotPath(tutorUid, slotBucket) {
        return /databases/$(database)/documents/tutorSlots/$(tutorUid)/slots/$(slotBucket);
      }

      function slotBucketsFor(startsAt) {
        let firstBucket = math.floor(startsAt.toMillis() / 1800000);
        return [firstBucket, firstBucket + 1];
      }

      function hasMatchingSlotAfter(data, bookingId, index) {
        let bucket = data.slotBuckets[index];
        return existsAfter(slotPath(data.tutorUid, bucket))
          && getAfter(slotPath(data.tutorUid, bucket)).data.bookingId == bookingId
          && getAfter(slotPath(data.tutorUid, bucket)).data.tutorUid == data.tutorUid
          && getAfter(slotPath(data.tutorUid, bucket)).data.studentUid == data.studentUid
          && getAfter(slotPath(data.tutorUid, bucket)).data.slotBucket == bucket
          && getAfter(slotPath(data.tutorUid, bucket)).data.startsAt == data.startsAt;
      }

      function slotRemovedAfter(data, index) {
        return !existsAfter(slotPath(data.tutorUid, data.slotBuckets[index]));
      }

      function isParticipant() {
        return signedIn()
          && (request.auth.uid == resource.data.studentUid
            || request.auth.uid == resource.data.tutorUid);
      }

      function isChatParticipant() {
        return signedIn()
          && exists(bookingPath())
          && (request.auth.uid == get(bookingPath()).data.studentUid
            || request.auth.uid == get(bookingPath()).data.tutorUid);
      }

      function maySendChat() {
        return isChatParticipant()
          && get(bookingPath()).data.status in ['pending', 'accepted', 'completed'];
      }

      function hasChatWritePermit(messageId) {
        let permit = getAfter(bookingChatWriteLimitPath(request.auth.uid)).data;
        return permit.uid == request.auth.uid
          && permit.lastSentAt == request.time
          && permit.messageId == messageId;
      }

      function validNewRequest() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'studentUid', 'tutorUid', 'studentName', 'tutorName',
            'subject', 'startsAt', 'slotBuckets', 'note', 'status', 'participantUids',
            'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'studentUid', 'tutorUid', 'studentName', 'tutorName',
            'subject', 'startsAt', 'slotBuckets', 'note', 'status', 'participantUids',
            'createdAt', 'updatedAt'
          ])
          && data.studentUid == request.auth.uid
          && data.tutorUid is string
          && data.tutorUid != request.auth.uid
          && data.studentName is string
          && data.studentName.size() > 0
          && data.studentName.size() <= 100
          && data.tutorName is string
          && data.tutorName.size() > 0
          && data.tutorName.size() <= 100
          && data.subject is string
          && data.subject.size() > 0
          && data.subject.size() <= 100
          && data.note is string
          && data.note.size() <= 2000
          && data.startsAt is timestamp
          && data.startsAt > request.time
          && data.startsAt.toMillis() % 1800000 == 0
          && data.startsAt.nanos() == 0
          && data.slotBuckets is list
          && data.slotBuckets.size() == 2
          && data.slotBuckets[0] is int
          && data.slotBuckets[1] is int
          && data.slotBuckets[0] == slotBucketsFor(data.startsAt)[0]
          && data.slotBuckets[1] == slotBucketsFor(data.startsAt)[1]
          && data.status == 'pending'
          && data.participantUids is list
          && data.participantUids.size() == 2
          && data.participantUids.hasAll([data.studentUid, data.tutorUid])
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && exists(tutorProfilePath(data.tutorUid))
          && get(tutorProfilePath(data.tutorUid)).data.visibility == 'listed'
          && get(tutorProfilePath(data.tutorUid)).data.name == data.tutorName
          && data.subject in get(tutorProfilePath(data.tutorUid)).data.subjects;
      }

      function changesStatusOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if isParticipant();
      allow list: if signedIn()
        && (resource.data.studentUid == request.auth.uid
          || resource.data.tutorUid == request.auth.uid)
        && request.query.limit is int
        && request.query.limit <= 100;
      allow create: if signedIn() && validNewRequest();
      allow update: if isParticipant()
        && changesStatusOnly()
        && ((resource.data.status == 'pending'
              && request.auth.uid == resource.data.tutorUid
              && ((request.resource.data.status == 'accepted'
                  && hasMatchingSlotAfter(resource.data, bookingId, 0)
                  && hasMatchingSlotAfter(resource.data, bookingId, 1))
                || request.resource.data.status == 'declined'))
          || (resource.data.status in ['pending', 'accepted']
              && request.resource.data.status == 'cancelled'
              && slotRemovedAfter(resource.data, 0)
              && slotRemovedAfter(resource.data, 1))
          || (resource.data.status == 'accepted'
              && request.resource.data.status == 'completed'
              && slotRemovedAfter(resource.data, 0)
              && slotRemovedAfter(resource.data, 1)));
      allow delete: if false;

      match /chatMessages/{messageId} {
        function validSenderName(booking) {
          return (request.auth.uid == booking.studentUid
              && request.resource.data.senderName == booking.studentName)
            || (request.auth.uid == booking.tutorUid
              && request.resource.data.senderName == booking.tutorName);
        }

        allow get: if isChatParticipant();
        allow list: if isChatParticipant()
          && request.query.limit is int
          && request.query.limit <= 50;
        allow create: if maySendChat()
          && request.resource.data.keys().hasAll([
            'senderUid', 'senderName', 'text', 'sentAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'sentAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 100
          && validSenderName(get(bookingPath()).data)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt == request.time
          && hasChatWritePermit(messageId);
        allow update, delete: if false;
      }

      match /chatWriteLimits/{userId} {
        function matchingMessage() {
          let data = request.resource.data;
          return data.keys().hasAll(['uid', 'lastSentAt', 'messageId'])
            && data.keys().hasOnly(['uid', 'lastSentAt', 'messageId'])
            && data.uid == userId
            && data.lastSentAt == request.time
            && data.messageId is string
            && data.messageId.size() > 0
            && data.messageId.size() <= 128
            && existsAfter(bookingChatMessagePath(data.messageId))
            && getAfter(bookingChatMessagePath(data.messageId)).data.senderUid == userId
            && getAfter(bookingChatMessagePath(data.messageId)).data.sentAt == request.time;
        }

        allow create: if maySendChat()
          && request.auth.uid == userId
          && matchingMessage();
        allow update: if maySendChat()
          && request.auth.uid == userId
          && matchingMessage()
          && resource.data.lastSentAt is timestamp
          && request.time >= resource.data.lastSentAt + duration.value(1, 's');
        allow delete: if false;
      }
    }

    // The lock path is derived from the request's numeric UTC half-hour bucket.
    // Each accepted one-hour request owns two adjacent locks, preventing both
    // exact-time duplicates and overlapping starts.
    match /tutorSlots/{tutorUid}/slots/{slotId} {
      function bookingPath(bookingId) {
        return /databases/$(database)/documents/tutorBookings/$(bookingId);
      }

      function canonicalSlotPath(slotBucket) {
        return /databases/$(database)/documents/tutorSlots/$(tutorUid)/slots/$(slotBucket);
      }

      allow get: if signedIn()
        && (request.auth.uid == tutorUid
          || request.auth.uid == resource.data.studentUid);
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == tutorUid
        && request.resource.data.keys().hasAll([
          'bookingId', 'tutorUid', 'studentUid', 'slotBucket', 'startsAt', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'bookingId', 'tutorUid', 'studentUid', 'slotBucket', 'startsAt', 'createdAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && request.resource.data.tutorUid == tutorUid
        && request.resource.data.slotBucket is int
        && request.path == canonicalSlotPath(request.resource.data.slotBucket)
        && request.resource.data.createdAt == request.time
        && existsAfter(bookingPath(request.resource.data.bookingId))
        && getAfter(bookingPath(request.resource.data.bookingId)).data.tutorUid == tutorUid
        && getAfter(bookingPath(request.resource.data.bookingId)).data.studentUid == request.resource.data.studentUid
        && getAfter(bookingPath(request.resource.data.bookingId)).data.slotBuckets.size() == 2
        && (getAfter(bookingPath(request.resource.data.bookingId)).data.slotBuckets[0]
              == request.resource.data.slotBucket
          || getAfter(bookingPath(request.resource.data.bookingId)).data.slotBuckets[1]
              == request.resource.data.slotBucket)
        && getAfter(bookingPath(request.resource.data.bookingId)).data.startsAt == request.resource.data.startsAt
        && getAfter(bookingPath(request.resource.data.bookingId)).data.status == 'accepted';
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == tutorUid
          || request.auth.uid == resource.data.studentUid)
        && resource.data.slotBucket is int
        && request.path == canonicalSlotPath(resource.data.slotBucket)
        && existsAfter(bookingPath(resource.data.bookingId))
        && getAfter(bookingPath(resource.data.bookingId)).data.tutorUid == tutorUid
        && getAfter(bookingPath(resource.data.bookingId)).data.slotBuckets.size() == 2
        && (getAfter(bookingPath(resource.data.bookingId)).data.slotBuckets[0]
              == resource.data.slotBucket
          || getAfter(bookingPath(resource.data.bookingId)).data.slotBuckets[1]
              == resource.data.slotBucket)
        && getAfter(bookingPath(resource.data.bookingId)).data.status in ['cancelled', 'completed'];
    }

    // Every collection not listed above is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
